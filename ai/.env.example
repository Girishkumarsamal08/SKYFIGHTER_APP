# ==============================================================================
# SKYFIGHTER DRONE VISION — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Fast-API Server Configuration
HOST=0.0.0.0
PORT=8000

# Video Stream Source Options: "simulation", "esp32_cam", or "webcam"
CAMERA_SOURCE=simulation

# AI-Thinker ESP32-CAM MJPEG Stream URL (e.g., http://192.168.4.2/stream or http://192.168.1.105/stream)
ESP32_CAM_URL=http://192.168.4.2/stream

# Webcam Device Index (0 = default laptop webcam / USB capture card)
WEBCAM_INDEX=0

# AI Model Paths
# 1. Specialized fine-tuned Fire & Smoke detector
FIRE_SMOKE_MODEL_PATH=ai_pipeline/models/best.pt

# 2. General COCO model for Person, Wildlife, Birds, and Animals
COCO_MODEL_PATH=yolov8n.pt

# Per-Class Detection Confidence Thresholds (0.00 to 1.00)
CONF_FIRE=0.30
CONF_SMOKE=0.30
CONF_PERSON=0.45
CONF_ANIMAL=0.40

# Temporal Persistence Filter (Frames required before firing persistent alert)
PERSISTENCE_THRESHOLD=6

# Alert Cooldown in seconds (Prevents repetitive alert sound/notification spam)
ALERT_COOLDOWN_SEC=10.0

# Target Video Stream Parameters
STREAM_FPS=30
JPEG_QUALITY=80
